flowchart LR
    subgraph users [People]
        party[Riders and drivers]
        reviewer[Support reviewer]
        judges[Judges / engineers]
    end
    subgraph vercel [Vercel · static]
        web[React + Vite + TypeScript<br/>rider and driver apps<br/>support console · AI trace]
    end
    subgraph render [Render · FastAPI]
        api[REST API]
        orch[Orchestrator<br/>state machine]
        rules[Deterministic rules<br/>prevention · escalation · compliance]
        agents[5 pydantic-ai agents<br/>+ Image Analysis]
        sse[SSE stream<br/>per case + support queue]
    end
    subgraph neon [Neon · one project]
        pg[(Postgres + pgvector<br/>trips · cases · trace_events<br/>decisions · llm_usage)]
        obj[(Object Storage<br/>evidence photos)]
    end
    subgraph ext [External services]
        models[DeepInfra<br/>Qwen3-235B · Gemma 4 vision<br/>Gemini as photo fallback]
        logfire[Pydantic Logfire]
    end

    party & reviewer & judges --> web
    web -- REST --> api
    api --> orch
    orch --> rules
    orch --> agents
    orch --> pg
    agents -- Evidence Collection only --> obj
    agents --> models
    agents -. spans .-> logfire
    pg -- LISTEN/NOTIFY --> sse
    sse -- live events --> web

    classDef store fill:#eef0f4,stroke:#10141c,stroke-width:1.5px,color:#10141c
    classDef extn fill:#ffffff,stroke:#79808f,stroke-width:1.5px,stroke-dasharray:4 3,color:#10141c
    classDef rule fill:#eef0f4,stroke:#10141c,stroke-width:1.5px,stroke-dasharray:4 3,color:#10141c
    class pg,obj store
    class models,logfire extn
    class rules rule
