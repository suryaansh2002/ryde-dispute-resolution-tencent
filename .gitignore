
# Node
node_modules/
npm-debug.log*

# Python
__pycache__/
*.pyc
.venv/
venv/

# Neon
.neon

# macOS
.DS_Store

# Impeccable design skill: the engine binary is downloaded on first use; the hook cache is per machine
.impeccable/hook.cache.json

# Secrets: never committed. Each machine keeps its own .env (see the deploy guide for
# the variables); only the example files are tracked.
.env
.env.*
!.env.example
