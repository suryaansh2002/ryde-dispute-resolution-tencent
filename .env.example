# Copy to .env at the repo root and fill in. The backend reads it on start-up
# (backend/app/config.py), and so do the data-generation scripts. Never commit .env.

# --- Database: Neon Postgres with pgvector ----------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require            # pooled URL
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require   # direct URL: app connections and the live SSE stream

# --- Evidence photos: Neon Object Storage (S3-compatible) ------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
OBJECT_STORAGE_BUCKET=ryde-resolve

# --- Models --------------------------------------------------------------------------
# The five agents and photo grading run on DeepInfra by default.
DEEPINFRA_API_KEY=
# Optional: Gemini Flash, the photo-grading fallback.
GOOGLE_API_KEY=
# Optional overrides; the defaults in backend/app/config.py are what the golden run used.
# AGENT_MODEL=deepinfra:Qwen/Qwen3-235B-A22B-Instruct-2507
# AGENT_FALLBACK_MODELS=deepinfra:Qwen/Qwen3.6-27B
# VISION_MODEL=deepinfra:google/gemma-4-31B-it-turbo
# VISION_FALLBACK_MODELS=google:gemini-3.5-flash
# Other providers, if AGENT_MODEL names one (nvidia:, openrouter:):
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# --- Observability (optional) --------------------------------------------------------
LOGFIRE_TOKEN=

# --- OneMap (optional, data generation only) -----------------------------------------
# Real Singapore road routes for synthetic trips. Without these, routes fall back to
# straight lines. Email and password let the token refresh itself.
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# ONEMAP_ACCESS_TOKEN=

# --- Server --------------------------------------------------------------------------
CORS_ORIGINS=*
